    TreeNode root,
    ref int diameter)
{
    if (root == null)
        return 0;

    int left = Height(root.Left, ref diameter);
    int right = Height(root.Right, ref diameter);

    diameter =
        Math.Max(diameter, left + right);

    return 1 + Math.Max(left, right);
}
```

**Time:** `O(N)`
