public static List<List<int>> VerticalTraversal(
    TreeNode root)
{
    List<List<int>> result =
        new List<List<int>>();

    if (root == null)
        return result;

    // HD -> Level -> sorted values
    SortedDictionary<
        int,
        SortedDictionary<int, List<int>>> map =
        new SortedDictionary<
            int,
            SortedDictionary<int, List<int>>>();

    Queue<(TreeNode node, int hd, int level)> queue =
        new Queue<(TreeNode, int, int)>();

    queue.Enqueue((root, 0, 0));

    while (queue.Count > 0)
    {
        var current = queue.Dequeue();

        if (!map.ContainsKey(current.hd))
            map[current.hd] =
                new SortedDictionary<int, List<int>>();

        if (!map[current.hd].ContainsKey(current.level))
            map[current.hd][current.level] =
                new List<int>();

        map[current.hd][current.level]
            .Add(current.node.Val);

        if (current.node.Left != null)
            queue.Enqueue(
                (current.node.Left,
                 current.hd - 1,
                 current.level + 1)
            );

        if (current.node.Right != null)
            queue.Enqueue(
                (current.node.Right,
                 current.hd + 1,
                 current.level + 1)
            );
    }

    foreach (var column in map.Values)
    {
        List<int> values = new List<int>();

        foreach (var level in column.Values)
        {
            level.Sort();
            values.AddRange(level);
        }

        result.Add(values);
    }

    return result;
}
