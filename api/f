private static void dfs(
        TreeNode root,
        List<Integer> path,
        List<List<Integer>> result) {

    if (root == null)
        return;

    path.add(root.val);

    // Store only complete root-to-leaf paths.
    if (root.left == null &&
        root.right == null) {

        result.add(new ArrayList<>(path));
