# 28. Minimum Time to Burn Binary Tree

**a2z-326**

From a target node, fire spreads:

```text
left
right
parent
```

So:

1. Build parent pointers.
2. BFS starting from target.

## Java

```java
public static int burnTree(
        TreeNode root,
        int target) {

    Map<TreeNode, TreeNode> parent = new HashMap<>();

    TreeNode targetNode =
        buildParentMap(root, target, parent);

    Queue<TreeNode> queue = new LinkedList<>();
    Set<TreeNode> visited = new HashSet<>();

    queue.offer(targetNode);
    visited.add(targetNode);

    int time = 0;

    while (!queue.isEmpty()) {

        int size = queue.size();
        boolean burnedNewNode = false;

        for (int i = 0; i < size; i++) {

            TreeNode current = queue.poll();

            if (current.left != null &&
                visited.add(current.left)) {

                queue.offer(current.left);
                burnedNewNode = true;
            }

            if (current.right != null &&
                visited.add(current.right)) {

                queue.offer(current.right);
                burnedNewNode = true;
            }

            TreeNode p = parent.get(current);

            if (p != null && visited.add(p)) {
                queue.offer(p);
                burnedNewNode = true;
            }
        }

        if (burnedNewNode)
            time++;
    }

    return time;
}

private static TreeNode buildParentMap(
        TreeNode root,
        int target,
        Map<TreeNode, TreeNode> parent) {

    Queue<TreeNode> queue = new LinkedList<>();
    queue.offer(root);

    TreeNode targetNode = null;

    while (!queue.isEmpty()) {

        TreeNode current = queue.poll();

        if (current.val == target)
            targetNode = current;

        if (current.left != null) {
            parent.put(current.left, current);
            queue.offer(current.left);
        }

        if (current.right != null) {
            parent.put(current.right, current);
            queue.offer(current.right);
        }
    }

    return targetNode;
}
```

