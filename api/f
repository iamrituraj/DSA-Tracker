public static TreeNode BuildTree(
    int[] inorder,
    int[] postorder)
{
    Dictionary<int, int> index =
        new Dictionary<int, int>();

    for (int i = 0; i < inorder.Length; i++)
        index[inorder[i]] = i;

    int postIndex = postorder.Length - 1;

    return Build(
        inorder,
        postorder,
        0,
        inorder.Length - 1,
        ref postIndex,
        index
    );
}

private static TreeNode Build(
    int[] inorder,
    int[] postorder,
    int left,
    int right,
    ref int postIndex,
    Dictionary<int, int> index)
{
    if (left > right)
        return null;

    int value = postorder[postIndex--];

    TreeNode root = new TreeNode(value);

    int mid = index[value];

    // Process right before left.
    root.Right = Build(
        inorder, postorder,
        mid + 1, right,
        ref postIndex, index
    );

    root.Left = Build(
        inorder, postorder,
        left, mid - 1,
        ref postIndex, index
    );

    return root;
}
```

**Time:** `O(N)`
**Space:** `O(N)`

