private static boolean mirror(
        TreeNode a,
        TreeNode b) {

    if (a == null && b == null)
        return true;

    if (a == null || b == null)
        return false;

    if (a.val != b.val)
        return false;

    // Outer + inner children must mirror.
    return mirror(a.left, b.right)
        && mirror(a.right, b.left);
