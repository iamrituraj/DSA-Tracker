```csharp
public static int WidthOfBinaryTree(TreeNode root)
{
    if (root == null)
        return 0;

    Queue<(TreeNode node, long index)> queue =
        new Queue<(TreeNode, long)>();

    queue.Enqueue((root, 0));

    long maxWidth = 0;

    while (queue.Count > 0)
    {
        int size = queue.Count;

        long first = queue.Peek().index;
        long last = first;

        for (int i = 0; i < size; i++)
        {
            var current = queue.Dequeue();

            // Normalize indices to avoid overflow.
            long index = current.index - first;
            last = index;

            if (current.node.Left != null)
            {
                queue.Enqueue((
                    current.node.Left,
                    2 * index + 1
                ));
            }

            if (current.node.Right != null)
            {
                queue.Enqueue((
                    current.node.Right,
                    2 * index + 2
                ));
            }
        }

        maxWidth = Math.Max(maxWidth, last + 1);
    }

    return (int)maxWidth;
}
```

**Time:** `O(N)`
**Space:** `O(N)`

