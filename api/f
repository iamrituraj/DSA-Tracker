            if (current.Left != null &&
                visited.Add(current.Left))
            {
                queue.Enqueue(current.Left);
                burnedNewNode = true;
            }

            if (current.Right != null &&
                visited.Add(current.Right))
            {
                queue.Enqueue(current.Right);
                burnedNewNode = true;
            }

            if (parent.ContainsKey(current))
            {
                TreeNode p = parent[current];

                if (visited.Add(p))
                {
                    queue.Enqueue(p);
                    burnedNewNode = true;
                }
            }
        }

        if (burnedNewNode)
            time++;
    }

    return time;
}

