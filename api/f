        new Dictionary<TreeNode, TreeNode>();

    TreeNode targetNode =
        BuildParentMap(root, target, parent);

    Queue<TreeNode> queue =
        new Queue<TreeNode>();

    HashSet<TreeNode> visited =
        new HashSet<TreeNode>();

    queue.Enqueue(targetNode);
    visited.Add(targetNode);

    int time = 0;

