public static TreeNode lca(
        TreeNode root,
        TreeNode p,
        TreeNode q) {

    if (root == null ||
        root == p ||
        root == q)
        return root;

    TreeNode left = lca(root.left, p, q);
    TreeNode right = lca(root.right, p, q);

    // One node found in each subtree.
    if (left != null && right != null)
        return root;

    return left != null ? left : right;
}
